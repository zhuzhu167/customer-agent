APP_NAME="customer-agent-backend"
APP_ENV="local"
API_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

DATABASE_URL="postgresql+psycopg://customer_agent:customer_agent@localhost:5432/customer_agent"
REDIS_URL="redis://localhost:6379/0"

LIVEKIT_URL="ws://localhost:7880"
PUBLIC_LIVEKIT_URL="ws://127.0.0.1:7880"
# local/docker compose 默认值；APP_ENV=production/staging 时必须替换为正式 key 和至少 32 字符的强 secret。
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_TOKEN_TTL_SECONDS="3600"

DEFAULT_ASR_PROVIDER="tencent_cloud"
DEFAULT_TTS_PROVIDER="tencent_cloud"
DEFAULT_LLM_PROVIDER="alibaba_cloud"

TENCENT_CLOUD_REGION="ap-guangzhou"
TENCENT_CLOUD_ASR_MODEL="16k_zh"
TENCENT_CLOUD_ASR_ENDPOINT="asr.tencentcloudapi.com"
TENCENT_CLOUD_REALTIME_ASR_HOST="asr.cloud.tencent.com"
TENCENT_CLOUD_REALTIME_ASR_ENGINE_MODEL_TYPE="16k_zh"
TENCENT_CLOUD_REALTIME_ASR_VOICE_FORMAT="1"
TENCENT_CLOUD_REALTIME_ASR_FILTER_DIRTY="0"
TENCENT_CLOUD_REALTIME_ASR_FILTER_MODAL="0"
TENCENT_CLOUD_REALTIME_ASR_FILTER_PUNC="0"
TENCENT_CLOUD_REALTIME_ASR_CONVERT_NUM_MODE="1"
TENCENT_CLOUD_TTS_ENDPOINT="tts.tencentcloudapi.com"
TENCENT_CLOUD_TTS_VOICE="101001"
TENCENT_CLOUD_TTS_CODEC="wav"
TENCENT_CLOUD_TTS_SAMPLE_RATE="16000"
TENCENT_CLOUD_SECRET_REF="env:TENCENT_CLOUD_SECRET_ID,TENCENT_CLOUD_SECRET_KEY"
TENCENT_CLOUD_SECRET_FILE="docs/密钥/腾讯云密钥.csv"
# 本地开发可从上面的密钥文件读取；APP_ENV=production/staging 时必须清空 *_SECRET_FILE，并使用环境变量或 Secret Manager 注入。
# TENCENT_CLOUD_SECRET_ID=""
# TENCENT_CLOUD_SECRET_KEY=""
# TENCENT_CLOUD_APP_ID=""

ALIBABA_CLOUD_REGION="cn-hangzhou"
ALIBABA_CLOUD_LLM_MODEL="qwen-plus"
ALIBABA_CLOUD_ENDPOINT="https://dashscope.aliyuncs.com/compatible-mode/v1"
ALIBABA_CLOUD_SECRET_REF="env:ALIBABA_CLOUD_API_KEY"
ALIBABA_CLOUD_SECRET_FILE="docs/密钥/阿里云密钥.md"
# APP_ENV=production/staging 时必须清空 ALIBABA_CLOUD_SECRET_FILE，并使用环境变量或 Secret Manager 注入。
# ALIBABA_CLOUD_API_KEY=""

SESSION_PERSIST_AUDIO="false"
REPLY_PREPARING_VISIBILITY="demo_debug_only"
ALLOW_TTS_TEXT_ONLY_FALLBACK="false"
AUTO_START_VOICE_WORKER="true"
TURN_LOW_CONFIDENCE_THRESHOLD="0.72"
VOICE_WORKER_LAUNCH_MODE="in_process"
VOICE_WORKER_ID="local-worker-1"
VOICE_WORKER_POLL_INTERVAL_SECONDS="1.0"
VOICE_WORKER_SESSION_POLL_SECONDS="1.0"
VOICE_WORKER_JOB_LEASE_SECONDS="120"
VOICE_WORKER_HEARTBEAT_INTERVAL_SECONDS="15.0"
VOICE_WORKER_MAX_ATTEMPTS="3"
TURN_SILENCE_TIMEOUT_SECONDS="12.0"
TURN_SILENCE_CHECK_INTERVAL_SECONDS="1.0"
TURN_BARGE_IN_RMS_THRESHOLD="0.018"
TURN_BARGE_IN_MIN_VOICE_FRAMES="2"
TURN_INTERRUPTION_RECOVERY_TIMEOUT_SECONDS="2.5"
